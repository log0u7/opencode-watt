{
  "name": "@log0u7/opencode-watt",
  "version": "0.3.1",
  "description": "Electric power and cost of local LLM inference for OpenCode: samples nvidia-smi/rocm-smi/RAPL/hwmon locally or over SSH, or Prometheus/VictoriaMetrics meters, integrates energy, and prices it per kWh with geolocation-based tariffs.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/log0u7/opencode-watt.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "oc-plugin": [
    "server"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:check": "pnpm run build && pnpm pack --dry-run",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "smoke:dist": "pnpm run build && node scripts/smoke-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test:coverage && pnpm run smoke:dist",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@opencode/plugin": "^2.0.26"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode-ai/plugin": "1.18.35",
    "@opencode-ai/sdk": "1.18.35",
    "@opencode/plugin": "2.0.26",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.1",
    "lefthook": "2.2.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
